{
  "type": "object",
  "description": "EvidenceNet record-level JSON object keyed by evidence_id.",
  "additionalProperties": {
    "type": "object",
    "required": [
      "evidence_id",
      "source",
      "pico",
      "core_entities",
      "target_disease",
      "study_design",
      "clinical_stage",
      "statistics",
      "score",
      "source_text"
    ],
    "properties": {
      "evidence_id": {"type": "string"},
      "source": {"type": "object"},
      "pico": {"type": "object"},
      "core_entities": {"type": "array"},
      "target_disease": {"type": "string"},
      "bio_mechanism": {"type": "string"},
      "phenotype": {"type": "string"},
      "experimental_context": {"type": "string"},
      "study_design": {"type": "string"},
      "clinical_stage": {"type": "string"},
      "statistics": {"type": "object"},
      "score": {"type": "object"},
      "source_text": {"type": "string"},
      "extraction_confidence": {"type": "number"},
      "linked_tarkg_entities": {"type": "array", "items": {"type": "string"}},
      "evidence_relations": {"type": "array"},
      "merged_from": {"type": "array"},
      "review_status": {"type": "string"},
      "created_at": {"type": "string"},
      "updated_at": {"type": "string"},
      "version": {"type": "integer"}
    }
  }
}
